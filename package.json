{
  "name": "qa-automation-assessment",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "bonus:generate": "node bonus/pipeline.mts generate",
    "bonus:run": "node bonus/pipeline.mts run",
    "bonus:typecheck": "tsc -p bonus/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "typescript": "6.0.3"
  }
}
